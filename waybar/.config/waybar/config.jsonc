{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 8,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "cpu", "memory", "tray"],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "default": "○",
      "empty": "○",
      "active": "●"
    },
    "persistent-workspaces": { "*": 5 },
    "on-click": "activate"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 45,
    "separate-outputs": true
  },

  "clock": {
    "format": "\uf017  {:%a %d %b   %H:%M}",
    "tooltip": false
  },

  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-muted": "\uf026  mute",
    "format-icons": { "default": ["\uf027", "\uf028"] }
  },

  "network": {
    "format-wifi": "\uf1eb  {essid}",
    "format-ethernet": "\uf0e8  Ethernet",
    "format-disconnected": "\uf071  Offline",
    "tooltip-format": "{ifname}: {ipaddr}"
  },

  "cpu": {
    "format": "\uf2db  {usage}%",
    "interval": 2
  },

  "memory": {
    "format": "\uf1c0  {percentage}%",
    "interval": 5
  },

  "tray": { "spacing": 10 }
}
