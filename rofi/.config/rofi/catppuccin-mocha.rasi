* {
    bg0:     #1E1E2Eee;
    bg1:     #313244ee;
    bg2:     #45475Aee;
    fg0:     #CDD6F4;
    fg1:     #A6ADC8;
    accent:  #B4BEFE;
    urgent:  #F38BA8;

    background-color:   transparent;
    text-color:         @fg0;
}

window {
    background-color:   @bg0;
    border:             2px solid;
    border-color:       @accent;
    border-radius:      14px;
    width:              520px;
    padding:            16px;
}

mainbox {
    background-color:   transparent;
    spacing:            10px;
}

inputbar {
    background-color:   @bg1;
    border-radius:      10px;
    padding:            10px 14px;
    spacing:            8px;
    children:           [prompt, entry];
}

prompt {
    color:              @accent;
    font:               "JetBrainsMono Nerd Font Bold 13";
}

entry {
    color:              @fg0;
    placeholder:        "Search...";
    placeholder-color:  @fg1;
}

listview {
    background-color:   transparent;
    columns:            1;
    lines:              8;
    spacing:            4px;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    border-radius:      8px;
    padding:            8px 12px;
    spacing:            10px;
    children:           [element-icon, element-text];
}

element selected {
    background-color:   @bg2;
    text-color:         @accent;
}

element-icon {
    size:               24px;
}

element-text {
    color:              inherit;
    vertical-align:     0.5;
}
